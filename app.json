{
  "expo": {
    "name": "PGow",
    "slug": "pgow-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "pgow",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pgow.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#060D10"
      },
      "package": "com.pgow.app",
      "googleServicesFile": "./google-services.json"
    },
    "androidStatusBar": {
      "translucent": true,
      "backgroundColor": "transparent"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#14E2B1"
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#060D10",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "@maplibre/maplibre-react-native"
    ]
  }
}
