<?xml version="1.0" encoding="utf-8"?>
<!-- PGow meal card: Eat and Skip. Each fires the category's own action intent. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pgow_buttons"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/pgow_eat"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginEnd="5dp"
        android:layout_weight="1"
        android:background="@drawable/pgow_btn_eat"
        android:gravity="center"
        android:text="✓  Eat"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/pgow_skip"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="5dp"
        android:layout_weight="1"
        android:background="@drawable/pgow_btn_skip"
        android:gravity="center"
        android:text="✕  Skip"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
