<?xml version="1.0" encoding="utf-8"?>
<!-- PGow meal card: Eat and Skip. Each fires the category's own action intent. The height is
     on this root so the heads-up view can override it from its <include>. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pgow_buttons"
    android:layout_width="match_parent"
    android:layout_height="@dimen/pgow_button_height"
    android:layout_marginTop="@dimen/pgow_buttons_gap"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/pgow_eat"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:background="@drawable/pgow_btn_eat"
        android:gravity="center"
        android:text="✓  Eat"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/pgow_button_text" />

    <TextView
        android:id="@+id/pgow_skip"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:background="@drawable/pgow_btn_skip"
        android:gravity="center"
        android:text="✕  Skip"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
        android:textSize="@dimen/pgow_button_text" />
</LinearLayout>
