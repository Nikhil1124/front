<?xml version="1.0" encoding="utf-8"?>
<!-- PGow meal card, expanded: the supplied notification design. Sizes are in pgow_dimens —
     the design's own on Android 12+, a compact set below it where the height cap is lower. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/pgow_icon"
            android:layout_width="@dimen/pgow_icon"
            android:layout_height="@dimen/pgow_icon"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/pgow_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
                android:textSize="@dimen/pgow_title" />

            <TextView
                android:id="@+id/pgow_chef"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Compat.Notification"
                android:textSize="@dimen/pgow_chef" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/pgow_menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/pgow_menu_gap"
        android:ellipsize="end"
        android:singleLine="true"
        android:textAppearance="@style/TextAppearance.Compat.Notification"
        android:textSize="@dimen/pgow_menu" />

    <include
        layout="@layout/pgow_meal_card_buttons"
        android:layout_width="match_parent"
        android:layout_height="@dimen/pgow_button_height"
        android:layout_marginTop="@dimen/pgow_buttons_gap" />

    <LinearLayout
        android:id="@+id/pgow_ad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="@color/pgow_line" />

        <TextView
            android:id="@+id/pgow_ad_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:letterSpacing="0.06"
            android:singleLine="true"
            android:textAllCaps="true"
            android:textAppearance="@style/TextAppearance.Compat.Notification"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pgow_card_gap"
            android:background="@drawable/pgow_ad_card"
            android:clipToOutline="true"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/pgow_ad_image"
                android:layout_width="match_parent"
                android:layout_height="@dimen/pgow_ad_image"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:id="@+id/pgow_ad_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="10dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/pgow_ad_brand"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
                        android:textSize="@dimen/pgow_brand" />

                    <TextView
                        android:id="@+id/pgow_ad_tagline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textAppearance="@style/TextAppearance.Compat.Notification"
                        android:textSize="@dimen/pgow_tagline" />
                </LinearLayout>

                <TextView
                    android:id="@+id/pgow_ad_cta"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/pgow_cta_height"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/pgow_btn_cta"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:singleLine="true"
                    android:textColor="@color/pgow_cta_text"
                    android:textSize="@dimen/pgow_cta_text" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
