<?xml version="1.0" encoding="utf-8"?>
<!-- PGow meal card, expanded: the whole in-app card. Android caps an expanded custom view's
     height, so the sponsor's banner is a short strip rather than the in-app card's photo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <include
        layout="@layout/pgow_meal_card_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <include
        layout="@layout/pgow_meal_card_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:id="@+id/pgow_ad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="@color/pgow_line" />

        <TextView
            android:id="@+id/pgow_ad_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:letterSpacing="0.04"
            android:singleLine="true"
            android:textAllCaps="true"
            android:textAppearance="@style/TextAppearance.Compat.Notification"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/pgow_ad_card"
            android:clipToOutline="true"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/pgow_ad_image"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:id="@+id/pgow_ad_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="10dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/pgow_ad_brand"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/pgow_ad_tagline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textAppearance="@style/TextAppearance.Compat.Notification"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/pgow_ad_cta"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/pgow_btn_cta"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:textColor="@color/pgow_cta_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
