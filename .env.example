# Local backend target used by Expo. Physical devices need your Mac's LAN IP, not localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.8:8000

# Optional simulator mode. Leave false/absent when integrating with the FastAPI backend.
EXPO_PUBLIC_USE_MOCK_API=false

# Debug Android manifests already allow local HTTP cleartext traffic.
EXPO_PUBLIC_ALLOW_CLEARTEXT=true
