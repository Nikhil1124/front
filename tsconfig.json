{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // This repo has no ESLint (`npm run lint` did not exist at all). These two are the part
    // of a linter that actually caught things here — a sweep found 120 dead symbols — and
    // they cost no new dependency and no new config file. `npm run lint` runs them.
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    // `mappers.check.ts` runs under plain `node`, which resolves the real ".ts" path.
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node"],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
